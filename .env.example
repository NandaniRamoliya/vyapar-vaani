# VyaparVaani starts with NO .env file and NO API keys. Everything below is optional.
# Copy to .env (Docker) or backend/.env (local) only if you want to change a default.

# Where shop databases live: DATA_DIR/platform.db (accounts) + DATA_DIR/shops/<shop>.db (one per shop)
DATA_DIR=data

# First admin account, created on first start. Change the password after logging in.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please

# Create two demo shops (logins nandani / nandani@123 and patel / patel@123). Use false for real shops.
SEED_DEMO=true

# Login sessions last this many days
SESSION_DAYS=30

# Websites allowed to call the API, comma-separated (your GitHub Pages site). * = any.
CORS_ORIGINS=*

# Port the server listens on (Docker serves the whole app on 3000)
PORT=3000
HOST=0.0.0.0
