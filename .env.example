# VyaparVaani AI Environment Configuration
# Default: Zero-key Offline Mock Mode is ENABLED out of the box!
# Evaluators and judges can run without setting any external keys.

# Optional: Add your Gemini or OpenAI API Key for cloud-assisted LLM extraction
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Database Settings
PORT=8000
HOST=0.0.0.0
DATABASE_PATH=vyapar_vaani.db

# Set to true to force deterministic multilingual NLP engine
MOCK_MODE=true
