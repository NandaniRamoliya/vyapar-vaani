# VyaparVaani works with NO .env file and NO API keys.
# Copy to backend/.env only if you want to change these defaults.

# Where the SQLite database is stored (Docker uses /data/vyapar_vaani.db)
DATABASE_PATH=vyapar_vaani.db

# Port the server listens on (Docker serves the whole app on 3000)
PORT=3000
HOST=0.0.0.0
